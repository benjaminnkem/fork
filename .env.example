NODE_ENV=development
APP_ENV=local
APP_VERSION=dev
LOG_LEVEL=debug

API_PORT=4000
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
SESSION_SECRET=
AUTH_NONCE_TTL_SECONDS=300
PUBLIC_RATE_LIMIT_TTL_SECONDS=60
PUBLIC_RATE_LIMIT_MAX=60

MONGODB_URI=mongodb://localhost:27017/fork
MONGODB_DB_NAME=fork
REDIS_URL=redis://localhost:6379

# Archive-capable Base Mainnet RPC. Public Base RPC is a fallback only.
BASE_CHAIN_ID=8453
BASE_RPC_URL=
BASE_FALLBACK_RPC_URL=https://mainnet.base.org

# Ethereum Mainnet RPC for Moonwell primary governance after MIP-X58.
ETHEREUM_CHAIN_ID=1
ETHEREUM_RPC_URL=
ETHEREUM_FALLBACK_RPC_URL=

MOONWELL_REGISTRY_VERSION=moonwell-core-2026-08-16
MOONWELL_ALLOW_REGISTRY_OVERRIDE=false

GOVERNANCE_POLL_INTERVAL_MS=60000
GOVERNANCE_BASE_START_BLOCK=
GOVERNANCE_ETHEREUM_START_BLOCK=
GOVERNANCE_LOG_BLOCK_RANGE=5000

ANVIL_BINARY=anvil
ANVIL_HOST=127.0.0.1
ANVIL_PORT_START=9500
MAX_PARALLEL_FORKS=2
SIMULATION_TIMEOUT_MS=120000
FORK_START_TIMEOUT_MS=180000
SIMULATION_RECEIPT_SCHEMA_VERSION=1

GROQ_API_KEY=
GROQ_PLANNER_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
AGENT_MAX_STEPS=10
AGENT_TIMEOUT_MS=90000
AGENT_REASONING_EFFORT=medium
AGENT_MAX_COMPLETION_TOKENS=2048
AGENT_MAX_INVALID_CALLS=3
AGENT_INCLUDE_REASONING=false

# Do not invent a financial default. Product owner must approve this before UI use.
DEFAULT_MIN_SAFETY_BUFFER_BPS=
SIMULATION_MAX_AGE_SECONDS=300

ENABLE_MAINNET_TRANSACTION_PREPARATION=false
ENABLE_AUTONOMOUS_MAINNET_EXECUTION=false

NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_BASE_CHAIN_ID=8453
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Set to 1 to run the live Playwright UI → API → Anvil path.
# RUN_WEB_E2E=
